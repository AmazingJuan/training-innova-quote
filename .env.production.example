# Plantilla del .env de producción. deploy/configurar-env.sh la copia a .env
# y genera APP_KEY y las contraseñas. Lo demás (correo) se completa a mano.

APP_NAME="Training Corporation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cotizaciones.trainingcorporation.com.co
APP_TIMEZONE=America/Bogota
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos: el servicio "db" de docker-compose.yml
# El servidor es MariaDB, pero con el driver mysql de Laravel: el driver mariadb crea
# las columnas uuid con el tipo nativo de MariaDB y no encajan con las migraciones existentes.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cotizaciones
DB_USERNAME=cotizaciones
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=cotizaciones.trainingcorporation.com.co

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Debe ser mayor que el --timeout del worker (150 s en docker-compose.yml).
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database

# Correo saliente: Microsoft Graph, como el buzón de Gerencia (app de Entra
# "App web Laravel - correos gerencia", con Application Mail.Send —y Mail.ReadWrite
# para mensajes de más de 4 MB— limitados a ese buzón). MAIL_FROM_ADDRESS debe ser ese buzón.
# Durante las pruebas de carga usar MAIL_MAILER=log (ver load-tests/README.md).
MAIL_MAILER=msgraph
MAIL_FROM_ADDRESS=gerencia@trainingcorporation.com.co
MAIL_FROM_NAME="Training Corporation"
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_FROM=gerencia@trainingcorporation.com.co

VITE_APP_NAME="${APP_NAME}"

# --- Infraestructura (docker-compose.yml) ---
# Dominio del certificado HTTPS y correo de aviso de Let's Encrypt.
APP_DOMAIN=cotizaciones.trainingcorporation.com.co
ACME_EMAIL=
# Memoria de MariaDB e hilos de PHP (FrankenPHP). Valores para una máquina de 4 GB (t3.medium).
DB_BUFFER_POOL=512M
PHP_THREADS=16
