# Plantilla del .env de producción. deploy/configurar-env.sh la copia a .env
# y genera APP_KEY y las contraseñas. Lo demás (correo) se completa a mano.

APP_NAME="Training Corporation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cotizaciones.trainingcorporation.com.co
APP_TIMEZONE=America/Bogota
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos: el servicio "db" de docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cotizaciones
DB_USERNAME=cotizaciones
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=cotizaciones.trainingcorporation.com.co

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Debe ser mayor que el --timeout del worker (150 s en docker-compose.yml).
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database

# Correo saliente (SMTP). En Gmail: MAIL_PASSWORD es una "contraseña de aplicación".
# Durante las pruebas de carga usar MAIL_MAILER=log (ver load-tests/README.md).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Infraestructura (docker-compose.yml) ---
# Dominio del certificado HTTPS y correo de aviso de Let's Encrypt.
APP_DOMAIN=cotizaciones.trainingcorporation.com.co
ACME_EMAIL=
# Memoria de MySQL y procesos de Apache. Valores para una máquina de 4 GB (t3.medium).
MYSQL_BUFFER_POOL=512M
APACHE_MAX_WORKERS=40
